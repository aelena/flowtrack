# Copy this file to .env before the first `docker compose up`.
#
#   cp .env.example .env
#
# The defaults below work as-is for local development. Change POSTGRES_PASSWORD
# and API_KEY before running FlowTrack anywhere other than your own machine.

# --- Database ---------------------------------------------------------------
POSTGRES_USER=flowtrack
POSTGRES_PASSWORD=flowtrack_secret
POSTGRES_DB=flowtrack

# Connection string used by the API container. The host is the compose service
# name (`db`) and the port is the container-internal 5432 — not the 7029 that
# is published to your host machine.
DATABASE_URL=postgresql+asyncpg://flowtrack:flowtrack_secret@db:5432/flowtrack

# --- API --------------------------------------------------------------------
# Sent by the client as the X-API-Key header on every request.
API_KEY=ft_dev_key_change_me

# Where uploaded project files live inside the API container. Backed by the
# `storage` docker volume, so it survives restarts.
STORAGE_PATH=/app/storage

# Comma-separated list of origins allowed to call the API.
# Add your Chrome extension origin here if you use the clipper:
#   CORS_ORIGINS=http://localhost:7027,chrome-extension://<your-extension-id>
CORS_ORIGINS=http://localhost:7027

# --- Tests ------------------------------------------------------------------
# The suite drops and recreates every table, so it refuses to run against a
# database whose name does not end in `_test`. Uncomment to override.
# TEST_DATABASE_URL=postgresql+asyncpg://flowtrack:flowtrack_secret@localhost:7029/flowtrack_test
